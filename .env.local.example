# MongoDB Atlas connection string (free M0 cluster)
# e.g. mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/mailservice?retryWrites=true&w=majority
# Required — this is the only credential that must live in an env file, since
# it's what the app uses to reach the database everything else is stored in.
MONGODB_URI=

# Gmail SMTP credentials — optional here.
# The recommended way to connect Gmail is the in-app Settings tab, which
# saves your address and App Password to the database. These env vars are
# only a fallback for headless/CI setups and are ignored once credentials
# exist in the database.
SMTP_EMAIL=
SMTP_APP_PASSWORD=

# Cloudinary credentials — optional here, same story as SMTP above.
# Connect Cloudinary from the Settings tab instead; these are only a fallback
# and are ignored once credentials exist in the database. Used to store email
# attachments and save a link with each Send History entry.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Port the Next.js server runs on (used by Electron to know where to load the app)
PORT=3000
